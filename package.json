{
  "name": "deal-room",
  "version": "0.1.0",
  "description": "Deal Room — a playable M&A simulation built from the game design document",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "start": "npm run build && node tools/serve.mjs",
    "balance": "npm run build && node tools/balance.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "npm run build && node tools/bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  }
}
